{
  "name": "martinez-polygon-clipping",
  "version": "0.9.0",
  "description": "Martinez polygon clipping algorithm, does boolean operation on polygons (multipolygons, polygons with holes etc): intersection, union, difference, xor",
  "keywords": [
    "boolean",
    "clipping",
    "geometry",
    "intersection",
    "martinez",
    "polygon",
    "union",
    "xor"
  ],
  "homepage": "https://github.com/w8r/martinez",
  "license": "MIT",
  "author": "Alex Milevski <info@w8r.name>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w8r/martinez.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/martinez.cjs",
  "module": "dist/martinez.js",
  "browser": "dist/martinez.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/martinez.js",
      "require": "./dist/martinez.cjs"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "bench": "vite build && vitest bench --run --reporter verbose",
    "lint": "oxlint src test bench demo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "dev": "vite --mode demo",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist/demo",
    "deploy:demo": "npm run build:demo && gh-pages --nojekyll -d dist/demo -t -m 'Deploy demo'",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "robust-predicates": "^2.0.4",
    "splaytree": "^0.1.4",
    "tinyqueue": "3.0.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.20.4",
    "@vitest/ui": "^5.0.2",
    "gh-pages": "^6.1.1",
    "glob": "^11.0.3",
    "json-stringify-pretty-compact": "^2.0.0",
    "jsts": "^2.12.1",
    "leaflet": "1.9.4",
    "leaflet-editable": "^1.3.2",
    "lil-gui": "^0.21.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^0.9.10",
    "polyclip-ts": "^0.16.8",
    "polygon-clipping": "^0.15.7",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,html,css,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,js,mjs,cjs}": "oxlint"
  }
}
